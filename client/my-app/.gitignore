**/build/
**/dist/

# misc
.DS_Store
*.pem
*.log
**/*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Sangat Penting: Agar SECRET_KEY Anda tidak bocor ke publik)
.env*
**/.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts